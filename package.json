{
  "name": "git-fresh",
  "version": "2.0.0",
  "description": "Safely refresh a Git working directory while preserving local changes.",
  "type": "module",
  "author": "Leynier Gutiérrez González",
  "license": "MIT",
  "keywords": [
    "git",
    "reset",
    "clean",
    "stash",
    "restore",
    "cli",
    "tool"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "git-fresh": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit --production",
    "validate": "bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "files": [
    "dist",
    "readme.md",
    "license"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@inquirer/checkbox": "^5.2.1",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/select": "^5.2.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leynier/git-fresh.git"
  },
  "bugs": {
    "url": "https://github.com/leynier/git-fresh/issues"
  },
  "homepage": "https://github.com/leynier/git-fresh#readme",
  "publishConfig": {
    "access": "public"
  }
}
